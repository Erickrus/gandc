<<< {"jsonrpc": "2.0", "method": "session/update", "params": {"sessionId": "ses_1c06c7cf7ffeccb0QbDAC14Kvo", "update": {"sessionUpdate": "tool_call_update", "toolCallId": "call_00_RITuSuJ6PFMcb5OkKODQ1302", "status": "completed", "kind": "read", "content": [{"type": "content", "content": {"type": "text", "text": "import random\n\n\ndef pi_leibniz(n):\n    \"\"\"Approximate pi using Leibniz formula: pi/4 = 1 - 1/3 + 1/5 - 1/7 + ...\"\"\"\n    total = 0\n    for i in range(n):\n        total += (-1) ** i / (2 * i + 1)\n    return 4 * total\n\n\ndef pi_monte_carlo(n):\n    \"\"\"Approximate pi using Monte Carlo method.\"\"\"\n    inside = 0\n    for _ in range(n):\n        x = random.random()\n        y = random.random()\n        if x * x + y * y <= 1:\n            inside += 1\n    return 4 * inside / n\n\n\nif __name__ == \"__main__\":\n    from sys import argv\n    n = int(argv[1]) if len(argv) > 1 else 1000000\n    print(f\"Leibniz({n}):     {pi_leibniz(n)}\")\n    print(f\"Monte Carlo({n}): {pi_monte_carlo(n)}\")\n    print(f\"math.pi:          {__import__('math').pi}\")\n"}}], "title": "", "rawInput": {"filePath": "/home/headless/workspace/pi.py"}, "rawOutput": {"output": "import random\n\n\ndef pi_leibniz(n):\n    \"\"\"Approximate pi using Leibniz formula: pi/4 = 1 - 1/3 + 1/5 - 1/7 + ...\"\"\"\n    total = 0\n    for i in range(n):\n        total += (-1) ** i / (2 * i + 1)\n    return 4 * total\n\n\ndef pi_monte_carlo(n):\n    \"\"\"Approximate pi using Monte Carlo method.\"\"\"\n    inside = 0\n    for _ in range(n):\n        x = random.random()\n        y = random.random()\n        if x * x + y * y <= 1:\n            inside += 1\n    return 4 * inside / n\n\n\nif __name__ == \"__main__\":\n    from sys import argv\n    n = int(argv[1]) if len(argv) > 1 else 1000000\n    print(f\"Leibniz({n}):     {pi_leibniz(n)}\")\n    print(f\"Monte Carlo({n}): {pi_monte_carlo(n)}\")\n    print(f\"math.pi:          {__import__('math').pi}\")\n", "metadata": {"truncated": false}}}}}
