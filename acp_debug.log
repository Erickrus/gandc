<<< {"jsonrpc": "2.0", "method": "session/update", "params": {"sessionId": "ses_1c06c7cf7ffeccb0QbDAC14Kvo", "update": {"sessionUpdate": "tool_call_update", "toolCallId": "call_00_3ywYKqmdTpwuxZXpABbA7525", "status": "in_progress", "kind": "edit", "title": "edit", "locations": [{"path": "/home/headless/workspace/pi.py"}], "rawInput": {"filePath": "/home/headless/workspace/pi.py", "oldString": "if __name__ == \"__main__\":\n    from sys import argv\n    n = int(argv[1]) if len(argv) > 1 else 1000000\n    print(f\"Leibniz({n}):     {pi_leibniz(n)}\")\n    print(f\"Monte Carlo({n}): {pi_monte_carlo(n)}\")\n    print(f\"math.pi:          {__import__('math').pi}\")", "newString": "def pi_wallis(n):\n    \"\"\"Approximate pi using Wallis product: pi/2 = prod (2n/(2n-1) * 2n/(2n+1))\"\"\"\n    total = 1.0\n    for i in range(1, n + 1):\n        total *= (4 * i * i) / (4 * i * i - 1)\n    return 2 * total\n\n\ndef pi_machin(n):\n    \"\"\"Approximate pi using Machin's formula: pi/4 = 4*arctan(1/5) - arctan(1/239)\n\n    Using arctan(x) = x - x^3/3 + x^5/5 - x^7/7 + ...\n    \"\"\"\n    def arctan(x, terms):\n        s = 0.0\n        for i in range(terms):\n            s += ((-1) ** i * (x ** (2 * i + 1))) / (2 * i + 1)\n        return s\n\n    return 4 * (4 * arctan(1 / 5, n) - arctan(1 / 239, n))\n\n\nif __name__ == \"__main__\":\n    from sys import argv\n    n = int(argv[1]) if len(argv) > 1 else 1000000\n    print(f\"Leibniz({n}):          {pi_leibniz(n)}\")\n    print(f\"Monte Carlo({n}):      {pi_monte_carlo(n)}\")\n    print(f\"Wallis({n}):           {pi_wallis(n)}\")\n    print(f\"Machin({n}):           {pi_machin(n)}\")\n    print(f\"math.pi:               {__import__('math').pi}\")"}}}}
